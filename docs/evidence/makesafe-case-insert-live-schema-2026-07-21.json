{
  "extensions": {
    "plpgsql": "1.0",
    "pgcrypto": "1.3",
    "uuid-ossp": "1.1"
  },
  "effective_mode": "legacy",
  "enforce_trigger": {
    "enabled": "O",
    "definition": "CREATE TRIGGER trg_makesafe_intake_cases_enforce BEFORE INSERT OR UPDATE ON public.makesafe_intake_cases FOR EACH ROW EXECUTE FUNCTION enforce_makesafe_intake_case_write()"
  },
  "cycle_constraint": "CHECK ((\"right\"(instruction_key, length(('/cycle:'::text || (cycle)::text))) = ('/cycle:'::text || (cycle)::text)))",
  "case_cycle_column": {
    "is_nullable": "NO",
    "column_default": "1"
  },
  "lineage_id_column": {
    "is_nullable": "NO",
    "column_default": null
  },
  "root_trigger_rules": {
    "requires_root_cycle_one": true,
    "sets_lineage_id_to_case_id": true
  },
  "service_role_privileges": {
    "cases_insert": true,
    "events_insert": true,
    "health_insert": true,
    "health_update": true,
    "sources_insert": true
  },
  "deterministic_case_columns_present": true,
  "deterministic_shape_constraint_present": true
}
